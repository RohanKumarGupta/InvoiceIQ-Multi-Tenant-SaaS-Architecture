# ── PostgreSQL ──────────────────────────────
POSTGRES_DB=invoiceiq
POSTGRES_USER=invoiceiq
POSTGRES_PASSWORD=invoiceiq_secret
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379

# ── RabbitMQ ────────────────────────────────
RABBITMQ_USER=invoiceiq
RABBITMQ_PASSWORD=rabbitmq_secret
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ── MinIO ───────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── JWT ─────────────────────────────────────
JWT_SECRET=change-me-to-a-random-256-bit-secret-in-production
JWT_ACCESS_TOKEN_EXPIRY=900000
JWT_REFRESH_TOKEN_EXPIRY=604800000

# ── AI (Anthropic Claude) ──────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Application ─────────────────────────────
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev
